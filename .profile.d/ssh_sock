# 4. ssh-agent discover and oneshot spawn

# TODO if running in tmux and we're set to use gpg-agent, test if it even works, and if not switch to a oneshot-spawned ssh-agent; export only into our own tmux env, not systemd

find_ssh_sock()
{
  if [ -n "$SSH_AUTH_SOCK" ]; then
    return
  fi

  # inside tmux, the session's own agent (see tmux-session) is authoritative;
  # never fall through to systemd/gpg-agent and leak it back into systemd
  if [ -n "$TMUX" ]; then
    local tmux_sock
    tmux_sock=$(tmux show-environment SSH_AUTH_SOCK 2>/dev/null | sed -n 's/^SSH_AUTH_SOCK=//p')
    if [ -n "$tmux_sock" ]; then
      export SSH_AUTH_SOCK="$tmux_sock"
      echo 'Set SSH_AUTH_SOCK from tmux session'
    fi
    return
  fi

  if [ -z "$SSH_AUTH_SOCK" ]; then
    if systemctl --user whoami >/dev/null 2>&1; then
      local systemd_sock
      systemd_sock=$(systemctl --user show-environment | grep SSH_AUTH_SOCK | cut -d= -f2-)
      if [ -n "$systemd_sock" ]; then
        export SSH_AUTH_SOCK="$systemd_sock"
        echo 'Set SSH_AUTH_SOCK from systemd'
      fi
    fi
  fi

  if [ -z "$SSH_AUTH_SOCK" ]; then
    local gpg_sock
    gpg_sock=$(gpgconf --list-dirs agent-ssh-socket)
    if [ -n "$gpg_sock" ]; then
      export SSH_AUTH_SOCK=$gpg_sock
      echo 'Set SSH_AUTH_SOCK from gpg-agent'
    fi
  fi

  export_ssh_sock
}

export_ssh_sock() {
  if [ -z "$SSH_AUTH_SOCK" ]; then
    echo 'No SSH_AUTH_SOCK set to export'
    return
  fi

  # a tmux session's agent stays private to that session
  if [ -n "$TMUX" ]; then
    return
  fi

  if systemctl --user whoami >/dev/null 2>&1; then
    local systemd_sock
    systemd_sock=$(systemctl --user show-environment | grep SSH_AUTH_SOCK | cut -d= -f2-)
    if [ -z "$systemd_sock" ] || [ "$systemd_sock" != "$SSH_AUTH_SOCK" ]; then
      systemctl --user import-environment SSH_AUTH_SOCK
      echo 'Exported SSH_AUTH_SOCK into systemd'
    fi
  fi

  # TODO which session tho ; and maybe opt-out/in
  # if type tmux >/dev/null && tmux has-session >/dev/null 2>&1; then
  #   tmux setenv -g SSH_AUTH_SOCK "$SSH_AUTH_SOCK"
  #   tmux setenv SSH_AUTH_SOCK "$SSH_AUTH_SOCK"
  #   echo 'Exported SSH_AUTH_SOCK into tmux'
  # fi

}

find_ssh_sock

